# Copy to .env and fill in. Never commit real keys.

# --- Database ---
DATABASE_URL=postgresql+psycopg://leadgen:leadgen@localhost:5432/leadgen
# Used by `make test` / pytest. Created automatically if missing.
TEST_DATABASE_URL=postgresql+psycopg://leadgen:leadgen@localhost:5432/leadgen_test

# --- App ---
LOG_LEVEL=INFO

# --- Queue (Redis + RQ) ---
REDIS_URL=redis://localhost:6379/0
QUEUE_NAME=leadgen
JOB_MAX_ATTEMPTS=5
JOB_BACKOFF_BASE_SECONDS=2
# RQ stops a job running longer than this; a crashed worker's job is retried or failed by RQ.
JOB_TIMEOUT_SECONDS=300
# How long finished / failed jobs stay visible in GET /jobs.
JOB_RESULT_TTL_SECONDS=3600
JOB_FAILURE_TTL_SECONDS=604800
# score_lead waits this long when its company is still being enriched.
SCORE_DEFER_SECONDS=5

# --- Enrichment ---
# "mock" is the only built-in provider. Real providers plug in behind the same Protocol.
ENRICHMENT_PROVIDER=
# Placeholder for a real provider key (empty on purpose).
ENRICHMENT_API_KEY=

# --- CRM ---
# "mock" (default) or "hubspot".
CRM_PROVIDER=
# HubSpot private-app access token (scope: crm.objects.contacts.write). Empty on purpose.
CRM_API_TOKEN=
# HubSpot sandbox accounts use the same API host; override only for a proxy or test double.
HUBSPOT_BASE_URL=https://api.hubapi.com
# Optional custom contact properties that must already exist in the portal.
# Leave empty to send only standard properties.
HUBSPOT_SCORE_PROPERTY=
HUBSPOT_SEGMENT_PROPERTY=

# --- Reasoning (LLM explains, never scores) ---
# false => the whole system works with no API key.
REASONING_ENABLED=
# "groq" (default) or "anthropic"
REASONING_PROVIDER=
GROQ_API_KEY=
# Empty => built-in default (openai/gpt-oss-20b). Groq retires models; check its model list.
GROQ_MODEL=
GROQ_BASE_URL=
ANTHROPIC_API_KEY=
# Empty => built-in default model (only used when REASONING_PROVIDER=anthropic).
ANTHROPIC_MODEL=
